module tb_bin2bcd;

    reg [11:0] binary;
    wire [15:0] bcd;

    integer i;
    integer errors = 0;
    reg [15:0] expected_bcd;

    bin2bcd DUT (
        .binary(binary),
        .bcd(bcd)
    );

    initial begin
        binary = 12'd0;

        // Test every possible 12-bit input.
        for (i = 0; i <= 4095; i = i + 1) begin
            binary = i;

            expected_bcd[15:12] = i / 1000;
            expected_bcd[11:8]  = (i / 100) % 10;
            expected_bcd[7:4]   = (i / 10) % 10;
            expected_bcd[3:0]   = i % 10;

            #10;

            if (bcd !== expected_bcd) begin
                $display(
                    "ERROR: binary=%0d expected=%h actual=%h",
                    binary, expected_bcd, bcd
                );
                errors = errors + 1;
            end
        end

        if (errors == 0)
            $display("PASS: all 4096 binary-to-BCD inputs.");
        else
            $display("FAIL: %0d errors.", errors);

        $finish;
    end

endmodule


module top #(
    parameter integer COUNT_HALF_PERIOD = 50_000_000,
    parameter integer SCAN_HALF_PERIOD  = 50_000
)(
    input  wire       clk,
    input  wire       btnC,
    output wire [6:0] seg,
    output wire [3:0] an,
    output wire       dp
);

    wire count_clk;
    wire scan_clk;
    wire [15:0] bcd;
    wire [3:0] selected_digit;

    reg [11:0] count = 12'd0;
    reg [1:0] digit_select = 2'd0;

    // Decimal point off.
    assign dp = 1'b1;

    // 100 MHz / (2 * 50,000,000) = 1 Hz.
    clock_divider #(
        .HALF_PERIOD(COUNT_HALF_PERIOD)
    ) count_clock (
        .clk(clk),
        .reset(btnC),
        .clk_out(count_clk)
    );

    // 100 MHz / (2 * 50,000) = 1 kHz.
    clock_divider #(
        .HALF_PERIOD(SCAN_HALF_PERIOD)
    ) scan_clock (
        .clk(clk),
        .reset(btnC),
        .clk_out(scan_clk)
    );

    // Count from 0 to 4095, then return to 0.
    always @(posedge count_clk or posedge btnC) begin
        if (btnC)
            count <= 12'd0;
        else if (count == 12'd4095)
            count <= 12'd0;
        else
            count <= count + 1'b1;
    end

    // Select the next display digit on each scan-clock edge.
    always @(posedge scan_clk or posedge btnC) begin
        if (btnC)
            digit_select <= 2'd0;
        else
            digit_select <= digit_select + 1'b1;
    end

    bin2bcd converter (
        .binary(count),
        .bcd(bcd)
    );

    digit_mux mux (
        .bcd(bcd),
        .select(digit_select),
        .digit(selected_digit)
    );

    anode_decoder anodes (
        .select(digit_select),
        .an(an)
    );

    seven_segment_decoder segments (
        .digit(selected_digit),
        .seg(seg)
    );

endmodule


// Generates a square-wave clock.
module clock_divider #(
    parameter integer HALF_PERIOD = 50_000_000
)(
    input  wire clk,
    input  wire reset,
    output reg  clk_out = 1'b0
);

    localparam integer WIDTH =
        (HALF_PERIOD <= 1) ? 1 : $clog2(HALF_PERIOD);

    reg [WIDTH-1:0] divider_count = 0;

    always @(posedge clk or posedge reset) begin
        if (reset) begin
            divider_count <= 0;
            clk_out <= 1'b0;
        end
        else if (divider_count == HALF_PERIOD - 1) begin
            divider_count <= 0;
            clk_out <= ~clk_out;
        end
        else begin
            divider_count <= divider_count + 1'b1;
        end
    end

endmodule


// Converts a 12-bit binary number into four decimal BCD digits.
// Uses the double-dabble algorithm.
module bin2bcd (
    input  wire [11:0] binary,
    output reg  [15:0] bcd
);

    integer i;

    always @(*) begin
        bcd = 16'd0;

        for (i = 11; i >= 0; i = i - 1) begin
            if (bcd[3:0] >= 5)
                bcd[3:0] = bcd[3:0] + 4'd3;

            if (bcd[7:4] >= 5)
                bcd[7:4] = bcd[7:4] + 4'd3;

            if (bcd[11:8] >= 5)
                bcd[11:8] = bcd[11:8] + 4'd3;

            if (bcd[15:12] >= 5)
                bcd[15:12] = bcd[15:12] + 4'd3;

            bcd = {bcd[14:0], binary[i]};
        end
    end

endmodule


// Selects one of the four decimal digits.
module digit_mux (
    input  wire [15:0] bcd,
    input  wire [1:0]  select,
    output reg  [3:0]  digit
);

    always @(*) begin
        case (select)
            2'd0: digit = bcd[3:0];   // Ones
            2'd1: digit = bcd[7:4];   // Tens
            2'd2: digit = bcd[11:8];  // Hundreds
            2'd3: digit = bcd[15:12]; // Thousands
            default: digit = 4'd0;
        endcase
    end

endmodule


// Active-low digit enables.
module anode_decoder (
    input  wire [1:0] select,
    output reg  [3:0] an
);

    always @(*) begin
        case (select)
            2'd0: an = 4'b1110;
            2'd1: an = 4'b1101;
            2'd2: an = 4'b1011;
            2'd3: an = 4'b0111;
            default: an = 4'b1111;
        endcase
    end

endmodule


// Active-low segments.
// seg[6:0] = {g, f, e, d, c, b, a}.
module seven_segment_decoder (
    input  wire [3:0] digit,
    output reg  [6:0] seg
);

    always @(*) begin
        case (digit)
            4'd0: seg = 7'b1000000;
            4'd1: seg = 7'b1111001;
            4'd2: seg = 7'b0100100;
            4'd3: seg = 7'b0110000;
            4'd4: seg = 7'b0011001;
            4'd5: seg = 7'b0010010;
            4'd6: seg = 7'b0000010;
            4'd7: seg = 7'b1111000;
            4'd8: seg = 7'b0000000;
            4'd9: seg = 7'b0010000;
            default: seg = 7'b1111111;
        endcase
    end

endmodule

